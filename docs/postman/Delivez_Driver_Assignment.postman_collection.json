    {
      "name": "4. Assign",
      "description": "Change who carries the delivery. Each change is in the delivery's history and the audit log, and the driver gets a notification.",
      "item": [
        {
          "name": "Assign driver",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('driver assigned', () => pm.expect(pm.response.json().driver.id).to.eql(pm.collectionVariables.get('driverId')));",
                  "const t = pm.response.json(); console.log(`${t.order && t.order.orderNumber} · ${t.status} · driver: ${t.driver ? t.driver.name + ' (' + t.driver.code + ')' : 'none'}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"riderId\": \"{{driverId}}\",\n  \"note\": \"Assigned from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/dispatch/tasks/{{taskId}}/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "dispatch",
                "tasks",
                "{{taskId}}",
                "assign"
              ]
            },
            "description": "For a delivery waiting for a driver. note is optional. 409 when the driver is busy / at the most orders or the delivery already has a driver."
          }
        },
