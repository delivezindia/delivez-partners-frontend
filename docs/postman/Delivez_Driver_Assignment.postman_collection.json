              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('new driver', () => pm.expect(pm.response.json().driver.id).to.eql(pm.collectionVariables.get('driver2Id')));",
                  "const t = pm.response.json(); console.log(`${t.order && t.order.orderNumber} · ${t.status} · driver: ${t.driver ? t.driver.name + ' (' + t.driver.code + ')' : 'none'}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"riderId\": \"{{driver2Id}}\",\n  \"reason\": \"First driver is stuck in traffic\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/dispatch/tasks/{{taskId}}/reassign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "dispatch",
                "tasks",
                "{{taskId}}",
                "reassign"
              ]
            },
            "description": "Moves it to another driver; reason (5+ characters) required. Allowed until pickup."
          }
        },
        {
          "name": "Remove driver (unassign)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('no driver now', () => pm.expect(pm.response.json().driver).to.eql(null));",
                  "const t = pm.response.json(); console.log(`${t.order && t.order.orderNumber} · ${t.status} · driver: ${t.driver ? t.driver.name + ' (' + t.driver.code + ')' : 'none'}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Driver asked to be taken off\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/dispatch/tasks/{{taskId}}/unassign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "dispatch",
                "tasks",
                "{{taskId}}",
                "unassign"
              ]
            },
            "description": "Back to waiting (auto-dispatch looks again); reason required. Allowed until pickup."
          }
        },
        {
          "name": "History of the delivery",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const h = pm.response.json().history || []; console.log(h.map((e) => `${e.action || e.to}${e.driver ? ' ' + e.driver : ''}${e.reason ? ' — ' + e.reason : ''}`).join(' | '));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/dispatch/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "dispatch",
                "tasks",
                "{{taskId}}"
              ]
            },
            "description": "history: who assigned / changed / removed which driver, when and why."
          }
        }
      ]
    }
  ]
}
