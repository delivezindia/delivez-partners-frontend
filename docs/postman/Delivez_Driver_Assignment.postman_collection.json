    {
      "name": "3. Pick a driver",
      "description": "The chosen delivery and the drivers who can take it.",
      "item": [
        {
          "name": "Open the delivery",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json(); console.log(`${t.order && t.order.orderNumber} · ${t.status} · driver: ${t.driver ? t.driver.name + ' (' + t.driver.code + ')' : 'none'}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/dispatch/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "dispatch",
                "tasks",
                "{{taskId}}"
              ]
            },
            "description": "Order, shop, pickup and drop, driver, auto-dispatch offers, what you can do (can.assign / reassign / unassign) and the history."
          }
        },
        {
          "name": "Drivers for this delivery (best first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const free = pm.response.json().items.filter((d) => d.canAssign);",
                  "pm.test('a driver is free', () => pm.expect(free.length).to.be.above(0));",
                  "if (free[0]) pm.collectionVariables.set('driverId', free[0].id);",
                  "if (free[1]) pm.collectionVariables.set('driver2Id', free[1].id);",
                  "console.log(free.slice(0, 2).map((d) => `${d.name} (${d.code}) ${d.distanceToPickupKm ?? '?'} km`).join(' · '));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/dispatch/drivers?taskId={{taskId}}&onlineOnly=false&search={{driverSearch}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "dispatch",
                "drivers"
              ],
              "query": [
                {
                  "key": "taskId",
                  "value": "{{taskId}}"
                },
                {
                  "key": "onlineOnly",
                  "value": "false"
                },
                {
                  "key": "search",
                  "value": "{{driverSearch}}"
                }
              ]
            },
            "description": "Only drivers of the delivery's city, with distance and ETA to the shop; free + online + nearest first. canAssign = false comes with the reason (busy, offline, at the most orders…). Saves the first two free drivers as driverId and driver2Id."
          }
        },
